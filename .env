# ---------------------------------------------------------------------------
# 数据源：
#   mock  = 内置演示数据（浏览器内模拟，开箱即用）
#   api   = 真实 HTTP 接口
#   local = 本地媒体服务（扫描硬盘目录，需先 npm run media:serve）
# ---------------------------------------------------------------------------
VITE_DATA_SOURCE=mock

# 后端接口基础路径（配合 vite proxy 使用，生产环境填真实的网关/服务地址）
VITE_API_BASE_URL=/api

# 演示用本地 mock server 地址（vite proxy 目标）
VITE_MOCK_SERVER_URL=http://127.0.0.1:8787

# 本地媒体服务地址（VITE_DATA_SOURCE=local 时代理目标）
VITE_MEDIA_SERVER_URL=http://127.0.0.1:8788

# 接口鉴权 Token（可选，会以 Authorization: Bearer <token> 发送）
VITE_API_TOKEN=

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=15000

# mock 模式下模拟的网络延迟（毫秒），设为 0 可即时返回
VITE_MOCK_DELAY=320

# ---------------------------------------------------------------------------
# 以下变量只在 Node 侧生效（不会暴露给前端）
# ---------------------------------------------------------------------------

# 扫描根目录，多个用分号或逗号分隔；给 npm run scan 与 POST /api/scan 使用
# 例：MEDIA_SCAN_ROOTS="D:/素材;D:/手机相册"
MEDIA_SCAN_ROOTS=.scan-demo

# ffmpeg / ffprobe 路径（可选）
# 留空时按 环境变量 → tools/media-toolkit/bin → 系统 PATH 的顺序自动探测，
# 一个都找不到时自动降级：只登记文件，不生成缩略图
MEDIA_FFMPEG_PATH=
MEDIA_FFPROBE_PATH=
